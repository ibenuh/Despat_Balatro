{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "stop running exe",
            "command": "$exe = Join-Path '${workspaceFolder}' 'build/main.exe'; Get-Process | Where-Object { $_.Path -eq $exe } | Stop-Process -Force",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "create build folder",
            "command": "New-Item -ItemType Directory -Force -Path '${workspaceFolder}/build' | Out-Null",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "MSYS2 g++: build Despat Balatro",
            "dependsOn": [
                "stop running exe",
                "create build folder"
            ],
            "dependsOrder": "sequence",
            "command": "$files = Get-ChildItem -LiteralPath '${workspaceFolder}' -Filter *.cpp | Sort-Object Name | ForEach-Object { $_.FullName }; & 'C:/msys64/ucrt64/bin/g++.exe' -fdiagnostics-color=always -g -std=c++17 @files -o '${workspaceFolder}/build/main.exe'",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds every .cpp file in Despat_Balatro with MSYS2 g++."
        },
        {
            "type": "shell",
            "label": "Run Despat Balatro",
            "dependsOn": "MSYS2 g++: build Despat Balatro",
            "dependsOrder": "sequence",
            "command": "& '${workspaceFolder}/build/main.exe'; Write-Host ''; Read-Host 'Press Enter to close'",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Builds Despat_Balatro, then runs build/main.exe."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:\\msys64\\ucrt64\\bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ]
}