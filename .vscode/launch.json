{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TDM-GCC: build and debug Despat Balatro",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/main.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "console": "integratedTerminal",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/usr/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "MSYS2 g++: build Despat Balatro"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/Users/user/Documents/GitHub/Despat_Balatro",
      "program": "c:/Users/user/Documents/GitHub/Despat_Balatro/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/TDM-GCC-64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}